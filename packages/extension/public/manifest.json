{
  "manifest_version": 3,
  "name": "litedesign",
  "version": "0.1.0",
  "description": "Figma-style grid, gap, and alignment on the real web page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "litedesign: watch this tab",
    "default_popup": "popup.html"
  }
}
